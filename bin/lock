#!/usr/bin/env bash

blur_radius=20
shots="${XDG_RUNTIME_DIR:-/tmp}/lock-blur"


swaylock_args=(
	--daemonize
	--no-unlock-indicator
	--ignore-empty-password
	--show-failed-attempts
	--color 000000
)

locked() {
	pgrep -x swaylock >/dev/null 2>&1
}

output_names() {
	niri msg --json outputs 2>/dev/null | jq -r 'values[].name' 2>/dev/null
}

blur_output() {
	local out="$1"
	local raw="$shots/raw.$out.png"
	local blurred="$shots/blur.$out.png"

	rm -f "$raw" "$blurred"
	grim -c -s 1 -o "$out" "$raw" || return 1
	stackblur -in "$raw" -out "$blurred" -radius "$blur_radius" || return 1
	rm -f "$raw"
}

locked && exit 0

image_args=()
outs=()

mkdir -p "$shots"
chmod 700 "$shots"

mapfile -t outs < <(output_names)

for o in "${outs[@]}"; do
	blur_output "$o" &
done

wait

for o in "${outs[@]}"; do
	f="$shots/blur.$o.png"
	[ -s "$f" ] && image_args+=(--image "$o:$f")
done


swaylock "${swaylock_args[@]}" "${image_args[@]}"
