ent=MAIN_WAN2] distance=6\n}\n:if ($u3 \u003e 0) do={\n    /ip route set [find comment=MAIN_WAN3] distance=1\n} else={\n    /ip route set [find comment=MAIN_WAN3] distance=4\n}\n:if ($wanPref != $newPref) do={\n    :foreach w in={\"wan1\";\"wan2\";\"wan3\"} do={\n        :if ($w != $newPref) do={\n            /ip firewall connection remove [find where connection-mark=(\"conn_\" . $w)]\n        }\n    }\n    :set wanPref $newPref\n}\n"},"sensitive_attributes":[],"private":"bnVsbA=="}]},{"mode":"managed","type":"routeros_tool_netwatch","name":"ccr2004_wan1_cf","provider":"provider[\"registry.opentofu.org/terraform-routeros/routeros\"].ccr2004","instances":[{"schema_version":0,"attributes":{"___id___":null,"___path___":null,"___skip___":null,"accept_icmp_time_exceeded":null,"comment":"WAN1","disabled":false,"dns_server":null,"down_script":"/system script run recompute_wan","early_failure_detection":null,"early_success_detection":null,"host":"192.168.100.1","http_code_max":null,"http_code_min":null,"id":"*1","interval":"5s","name":"wan1-cf","packet_count":5,"packet_interval":null,"packet_size":null,"port":null,"record_type":null,"src_address":null,"start_delay":null,"startup_delay":null,"test_script":"","thr_avg":null,"thr_http_time":null,"thr_jitter":null,"thr_loss_count":null,"thr_loss_percent":80,"thr_max":null,"thr_stdev":null,"thr_tcp_conn_time":null,"timeout":"1s","ttl":null,"type":"icmp","up_script":"/system script run recompute_wan"},"sensitive_attributes":[],"private":"bnVsbA=="}]},{"mode":"managed","type":"routeros_tool_netwatch","name":"ccr2004_wan1_goog","provider":"provider[\"registry.opentofu.org/terraform-routeros/routeros\"].ccr2004","instances":[{"schema_version":0,"attributes":{"___id___":null,"___path___":null,"___skip___":null,"accept_icmp_time_exceeded":null,"comment":"WAN1","disabled":null,"dns_server":null,"down_script":"/system script run recompute_wan","early_failure_detection":null,"early_success_detection":null,"host":"192.168.100.2","http_cod